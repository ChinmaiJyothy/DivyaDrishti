# App
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./divyadrishti.db

# Auth
SECRET_KEY=change-this-to-a-32-byte-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Astrology
AYANAMSA=lahiri
HOUSE_SYSTEM=sripati
EPHEMERIS_PATH=

# LLM
# Supported: openai, grok, gemini, anthropic, ollama, mock
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Provider-specific keys (used when LLM_PROVIDER is set accordingly)
OPENAI_API_KEY=${LLM_API_KEY}
GROK_API_KEY=${LLM_API_KEY}
GROK_BASE_URL=https://api.x.ai/v1
GEMINI_API_KEY=${LLM_API_KEY}
ANTHROPIC_API_KEY=${LLM_API_KEY}
OLLAMA_BASE_URL=http://localhost:11434
